# ============================================
# FCG Users API - Environment Variables
# ============================================
# Este arquivo é um TEMPLATE. 
# NÃO COMMITAR VALORES REAIS NO GIT!
#
# Para desenvolvimento local:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores
# 3. Use dotnet user-secrets (recomendado) ou .env
#
# Para produção:
# Configure as variáveis de ambiente no host (Kubernetes, Azure, AWS, etc.)
# ============================================

# Database Connection
ConnectionStrings__DefaultConnection=Server=localhost;Database=FcgUsersDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True

# JWT Configuration
JwtSettings__SecretKey=sua-chave-secreta-com-no-minimo-32-caracteres-aqui-use-um-gerador-seguro
JwtSettings__Issuer=FCG-Users-API
JwtSettings__Audience=FCG-Users-API
JwtSettings__ExpiracaoEmMinutos=60

# RabbitMQ Configuration
RabbitMQ__HostName=localhost
RabbitMQ__Port=5672
RabbitMQ__UserName=guest
RabbitMQ__Password=guest
RabbitMQ__VirtualHost=/
RabbitMQ__ExchangeName=fcg.users.events
